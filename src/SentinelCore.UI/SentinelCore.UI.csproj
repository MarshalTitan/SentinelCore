<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <PackageId>MarshalTitan.SentinelCore.UI</PackageId>
    <Title>Sentinel Core UI</Title>
    <Description>Shared Classic and opt-in Sentinel Modern ImGui themes, application shell, motion, surfaces, navigation, and balanced style helpers.</Description>
    <PackageTags>sentinel;dalamud;ffxiv;imgui;library</PackageTags>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <Use_Dalamud_FFXIVClientStructs>false</Use_Dalamud_FFXIVClientStructs>
    <Use_Dalamud_Newtonsoft_Json>false</Use_Dalamud_Newtonsoft_Json>
    <Use_Dalamud_Lumina>false</Use_Dalamud_Lumina>
    <Use_Dalamud_Lumina_Excel>false</Use_Dalamud_Lumina_Excel>
    <Use_Dalamud_Serilog>false</Use_Dalamud_Serilog>
    <Use_Dalamud_MSObjectPool>false</Use_Dalamud_MSObjectPool>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SentinelCore/SentinelCore.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>

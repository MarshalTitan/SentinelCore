    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SentinelCore.UI/SentinelCore.UI.csproj" />
